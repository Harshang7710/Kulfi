<section class="grid two">
<article class="card">
<h2>Movement</h2>
<p class="muted">Move stock between fridges, receive vendor stock into the Second Fridge, or return damaged stock back to the vendor.</p>
<form method="post" action="/owner/movements" class="form-grid two-col">
<%- include('partials/csrf') %>
<label>Workflow<select name="movementAction">
<option value="transfer_second_to_main">Second Fridge → Main Fridge</option>
<option value="vendor_stock_in">Vendor intake → Second Fridge</option>
<option value="vendor_return">Damaged stock → Vendor return</option>
</select></label>
<label>Item<select name="itemId" required>
<% items.forEach(i => { %><option value="<%= i.id %>"><%= i.name %> (<%= i.piecesPerBox %> pcs/box)</option><% }) %>
</select></label>
<label>Quantity (boxes)<input name="boxes" type="number" min="1" step="1" required></label>
<label>Notes<input name="notes" placeholder="Invoice, reason, or damage details"></label>
<button class="primary">Record movement</button>
</form>
</article>
<article class="card">
<h2>Unit logic</h2>
<ul class="feed">
<li><span>Main Fridge</span><span>Tracked as individual pieces for retail sales.</span></li>
<li><span>Second Fridge</span><span>Tracked as boxes for vendor/wholesale stock.</span></li>
<li><span>Transfers</span><span>Entered in boxes and converted to pieces automatically.</span></li>
</ul>
</article>
</section>
<article class="card">
<h2>Movement history</h2>
<form class="form-grid two-col" method="get">
<label>Filter by item<select name="itemId">
<option value="">All items</option>
<% items.forEach(i => { %><option value="<%= i.id %>" <%= query.itemId === i.id ? 'selected' : '' %>><%= i.name %></option><% }) %>
</select></label>
<label>Filter by type<select name="type">
<option value="">All types</option>
<% movementTypes.forEach(t => { %><option value="<%= t %>" <%= query.type === t ? 'selected' : '' %>><%= t.replaceAll('_',' ') %></option><% }) %>
</select></label>
<button class="btn secondary">Filter</button>
<% if (query.itemId || query.type) { %><a class="btn secondary" href="/owner/movements">Clear filters</a><% } %>
</form>
<div class="table-wrap">
<table>
<thead><tr><th>Date</th><th>Item</th><th>Type</th><th>Pieces</th><th>Boxes</th><th>Source</th><th>Destination</th><th>Created by</th><th>Notes</th></tr></thead>
<tbody>
<% rows.forEach(r => { %>
<tr>
<td><%= new Date(r.createdAt).toLocaleString() %></td>
<td><%= r.item.name %></td>
<td><%= r.movementType.replaceAll('_',' ') %></td>
<td><%= r.quantityPieces %></td>
<td><%= money(r.quantityBoxes) %></td>
<td><%= r.sourceLocation || '' %></td>
<td><%= r.destinationLocation || '' %></td>
<td><%= r.creator.name %></td>
<td><%= r.notes || '' %></td>
</tr>
<% }) %>
<% if (!rows.length) { %><tr><td colspan="9" class="empty">No stock movement records found.</td></tr><% } %>
</tbody>
</table>
</div>
</article>

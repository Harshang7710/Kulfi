<article class="card">
<div class="table-wrap">
<table>
<thead><tr><th>Bill</th><th>Item</th><th>Sold</th><th>Returned</th><th>Remaining</th><th>Refund/pc</th><th>Return</th></tr></thead>
<tbody>
<% rows.forEach(r => { %>
<tr>
<td><%= r.billNumber %></td>
<td><%= r.name %></td>
<td><%= r.quantity %></td>
<td><%= r.returnedQty %></td>
<td><%= r.quantity - r.returnedQty %></td>
<td>₹<%= r.isFree ? '0.00' : money(r.mrp) %></td>
<td>
<form class="actions" method="post" action="/manager/returns">
<%- include('partials/csrf') %>
<input type="hidden" name="saleItemId" value="<%= r.id %>">
<input name="quantity" type="number" min="1" max="<%= r.quantity - r.returnedQty %>" aria-label="Return quantity for <%= r.name %> from bill <%= r.billNumber %>" required>
<button class="btn secondary">Process return</button>
</form>
</td>
</tr>
<% }) %>
<% if (!rows.length) { %><tr><td colspan="7" class="empty">No returnable items for your sales today.</td></tr><% } %>
</tbody>
</table>
</div>
</article>

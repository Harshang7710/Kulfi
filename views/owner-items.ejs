<article class="card">
<h2>Add item</h2>
<form method="post" action="/owner/items" class="form-grid" data-image-upload-form>
<%- include('partials/csrf') %>
<label>Numeric Item ID<input name="itemCode" type="number" min="1" step="1" required></label>
<label>Name<input name="name" required></label>
<label>MRP<input name="mrp" type="number" min="0.01" step="0.01" required></label>
<label>Profit %<input name="profitPercentage" type="number" min="0" step="0.01" placeholder="Blank until known"></label>
<label>Pieces/box<input name="piecesPerBox" type="number" min="1" step="1" placeholder="Blank"></label>
<label>Low threshold<input name="lowStockThreshold" type="number" min="0" step="1" placeholder="Blank"></label>
<label>Product image (optional)<input name="imageUpload" type="file" accept="image/*" data-image-upload aria-describedby="image-upload-hint"><input name="imageData" type="hidden" data-image-data><small id="image-upload-hint" class="muted">Lightweight upload: saved as a small browser-compressed image.</small></label>
<button class="primary">Add item</button>
</form>
</article>
<article class="card">
<h2>Item catalog</h2>
<div class="table-wrap">
<form method="post" action="/owner/items/update">
<%- include('partials/csrf') %>
<table>
<thead><tr><th>Image</th><th>ID</th><th>Name</th><th>MRP</th><th>Profit %</th><th>Pieces/box</th><th>Low</th><th>Status</th></tr></thead>
<tbody>
<% rows.forEach(r => { %>
<tr>
<td><% if (r.imageData) { %><img class="item-thumb" src="<%= r.imageData %>" alt="<%= r.name %> image"><% } else { %>—<% } %></td>
<td><input name="itemCode_<%= r.id %>" type="number" min="1" step="1" value="<%= r.itemCode %>" required aria-label="Item ID for <%= r.name %>"></td>
<td><input name="name_<%= r.id %>" value="<%= r.name %>" required aria-label="Name for item <%= r.itemCode %>"></td>
<td><input name="mrp_<%= r.id %>" type="number" min="0.01" step="0.01" value="<%= money(r.mrp) %>" required aria-label="MRP for <%= r.name %>"></td>
<td><input name="profitPercentage_<%= r.id %>" type="number" min="0" step="0.01" value="<%= r.profitPercentage ?? '' %>" aria-label="Profit percentage for <%= r.name %>"></td>
<td><input name="piecesPerBox_<%= r.id %>" type="number" min="1" step="1" value="<%= r.piecesPerBox ?? '' %>" aria-label="Pieces per box for <%= r.name %>"></td>
<td><input name="lowStockThreshold_<%= r.id %>" type="number" min="0" step="1" value="<%= r.lowStockThreshold ?? '' %>" aria-label="Low stock threshold for <%= r.name %>"></td>
<td><label class="inline-check"><input type="checkbox" name="active_<%= r.id %>" <%= r.active ? 'checked' : '' %>> Active</label><label class="inline-check"><input type="checkbox" name="hidden_<%= r.id %>" <%= r.hidden ? 'checked' : '' %>> Hidden</label></td>
</tr>
<% }) %>
<% if (!rows.length) { %><tr><td colspan="8" class="empty">No items yet.</td></tr><% } %>
</tbody>
</table>
<p class="actions"><button class="primary">Save catalog changes</button></p>
</form>
</div>
</article>

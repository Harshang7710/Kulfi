<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %> · Desi Mastaani Matka Kulfi</title><link rel="icon" type="image/svg+xml" href="/logo.svg"><link rel="manifest" href="/manifest.webmanifest"><meta name="theme-color" content="#e83f46"><link rel="stylesheet" href="/styles.css"><script src="/app.js" defer></script></head><body class="route-<%= path ? path.replace(/[^a-z0-9]+/gi, '-').replace(/^-|-$/g, '').toLowerCase() : 'guest' %>">
<a href="#main" class="skip-link">Skip to content</a>
<% if (user) { %><div class="app"><aside class="sidebar"><a class="brand" href="<%= user.role==='owner'?'/owner':'/manager' %>"><img src="/logo.svg" alt="Desi Mastaani Matka Kulfi logo"><span>Desi Mastaani<br><span>Matka Kulfi</span></span></a><nav aria-label="Main navigation">
<% const ownerNav=[['/owner','Dashboard'],['/owner/reports','Sales Reports'],['/owner/items','Items'],['/owner/inventory','Inventory'],['/owner/movements','Movement'],['/owner/users','Users']]; const managerNav=[['/manager','Home'],['/manager/pos','POS Billing'],['/manager/returns','Returns'],['/manager/stock','Available Stock']]; (user.role==='owner'?ownerNav:managerNav).forEach(([href,label],index)=>{ %><a class="nav nav-idx-<%= index %> <%= path===href?'active':'' %>" href="<%= href %>"<% if (path===href) { %> aria-current="page"<% } %>><%= label %></a><% }) %>
<form method="post" action="/logout"><%- include('partials/csrf') %><button class="nav logout">Logout</button></form></nav></aside><main class="content" id="main"><header class="top"><div><p class="eyebrow"><%= user.role==='owner'?'Owner Control Center':'Manager Workspace' %></p><h1><%= title %></h1></div><div class="userpill"><%= user.name %><% if (user.userId) { %> · ID <%= user.userId %><% } %></div></header><% if (notice) { %><div class="notice <%= notice.type %>" role="alert"><span><%= notice.message %></span><button type="button" class="notice-close" data-notice-close aria-label="Dismiss notification">&times;</button></div><% } %><%- body %></main></div><% } else { %><main id="main"><%- body %></main><% } %>
</body></html>
